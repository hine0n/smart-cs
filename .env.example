# ==== 阿里云百炼 / DashScope 配置 ====
# 百炼 API Key（必填），从 https://bailian.console.aliyun.com 获取
DASHSCOPE_API_KEY=sk-your-dashscope-key-here

# 百炼兼容 OpenAI 的接口地址（无需修改）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 对话模型（可选：qwen-turbo / qwen-plus / qwen-max / qwen3-xxx）
LLM_MODEL=qwen3.6-plus
LLM_TEMPERATURE=0.3

# Embedding 模型（百炼 text-embedding-v3，默认 1024 维）
EMBEDDING_MODEL=text-embedding-v3

# ==== RAG 配置 ====
# 文本分块大小
CHUNK_SIZE=500
# 分块重叠大小
CHUNK_OVERLAP=50
# 初始检索返回数量（Top K）
RETRIEVAL_K=5

# ==== Reranker 配置 ====
# 重排序模式: "llm" (LLM打分) | "cross-encoder" (本地模型，更精准)
RERANK_MODE=llm
# 送入重排序的文档数
RERANK_TOP_K=5
# 重排序后保留的文档数
RERANK_FINAL_K=3

# ==== 安全与治理（可选） ====
# 后端 API Key：设置后所有接口强制校验 X-API-Key 请求头；留空则不鉴权（开发态）
API_KEY=
# 允许跨域的前端域名，逗号分隔；默认 *（放开所有）。生产环境建议限定具体域名
CORS_ORIGINS=*
